          "rawQuery": true,
          "rawSql": "SELECT \n  -- On crée les étiquettes du camembert\n  CASE \n    WHEN pos.Max_Active_OP IS NULL THEN 'Flux Amont'\n    ELSE CONCAT('OP ', pos.Max_Active_OP)\n  END AS `Position Actuelle`,\n  \n  -- On compte combien d'OF sont agglutinés à cet endroit\n  COUNT(p_unique.OrderNum) AS `Nombre d'OF`\n\nFROM (\n  -- 1. On liste tous les OF de la semaine\n  SELECT OrderNum \n  FROM planning_global \n  WHERE Ligne = 'MLG' \n    AND Semaine IN ($semaine) \n    AND OrderNum != 'Libre'\n  GROUP BY OrderNum\n) p_unique\n\nLEFT JOIN (\n  -- 2. On cherche la position actuelle de chaque OF (Le Radar propre)\n  SELECT \n    o_sub.OrderNum,\n    MAX(CAST(o_sub.OrderStepSequenceNum AS UNSIGNED)) AS Max_Active_OP\n  FROM orderoperation o_sub\n  JOIN config_station cs \n    ON CAST(o_sub.OrderStepSequenceNum AS CHAR) = CAST(cs.OrderStepSequenceNum AS CHAR)\n   AND cs.Ligne LIKE '%MLG%'\n  WHERE o_sub.FirstActivityTime IS NOT NULL OR o_sub.Status = 'Completed'\n  GROUP BY o_sub.OrderNum\n) pos ON CAST(p_unique.OrderNum AS CHAR) = CAST(pos.OrderNum AS CHAR)\n\n-- 3. FILTRE MAGIQUE : On exclut les pièces sorties de ligne (OP 900)\nWHERE IFNULL(pos.Max_Active_OP, 0) != 900\n\n-- On regroupe par position pour faire les parts du gâteau\nGROUP BY `Position Actuelle`, pos.Max_Active_OP\n\n-- On trie l'affichage pour que le camembert tourne dans le sens de la ligne\nORDER BY \n  CASE \n    WHEN pos.Max_Active_OP IS NULL THEN 0 \n    ELSE pos.Max_Active_OP \n  END ASC;",
