      "pluginVersion": "12.3.1",
      "targets": [
        {
          "dataset": "kpi_db",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n  OF_Num AS `Numéro OF`,\n  Takt,\n  DATE_FORMAT(Debut_Theo, '%d/%m %H:%i') AS `Début Théorique`,\n  DATE_FORMAT(Fin_Theo, '%d/%m %H:%i') AS `Fin Théorique`,\n  IFNULL(DATE_FORMAT(Debut_Reel, '%d/%m %H:%i'), '-') AS `Début Réel`,\n  IFNULL(DATE_FORMAT(Fin_Reel, '%d/%m %H:%i'), '-') AS `Fin Réelle`,\n  \n  -- NOUVELLE COLONNE : L'état strict de la pièce sur la station que tu as sélectionnée\n  CASE \n    WHEN Statut_Brut = 'Completed' THEN '🟢 Terminé'\n    WHEN Debut_Reel IS NOT NULL THEN '🟠 En cours'\n    ELSE '⚪ Pas commencé'\n  END AS `État`,\n  \n  -- LA COLONNE RADAR : Déconnectée des couleurs de retard, elle dit juste où est la pièce\n  CASE \n    WHEN Max_Active_OP IS NULL THEN 'Stock Amont'\n    ELSE CONCAT('OP ', Max_Active_OP)\n  END AS `OP Actuel`,\n  \n  -- L'écart propre (Calculé uniquement sur les temps de la station sélectionnée)\n  CASE \n    WHEN Diff_Sec > 0 THEN CONCAT('+', LPAD(FLOOR(Diff_Sec / 3600), 2, '0'), 'h', LPAD(FLOOR((Diff_Sec % 3600) / 60), 2, '0'))\n    WHEN Diff_Sec <= 0 AND (Statut_Brut = 'Completed' OR Debut_Reel IS NOT NULL) THEN CONCAT('-', LPAD(FLOOR(ABS(Diff_Sec) / 3600), 2, '0'), 'h', LPAD(FLOOR((ABS(Diff_Sec) % 3600) / 60), 2, '0'))\n    ELSE '-'\n  END AS `Écart`\n\nFROM (\n  SELECT \n    p.OrderNum AS OF_Num,\n    p.Takt,\n    STR_TO_DATE(CONCAT(p.Annee, '/', TRIM(p.Heure_Debut)), '%Y/%d/%m %H:%i') AS Debut_Theo,\n    STR_TO_DATE(CONCAT(p.Annee, '/', TRIM(p.Heure_Fin)), '%Y/%d/%m %H:%i') AS Fin_Theo,\n    o.FirstActivityTime AS Debut_Reel,\n    o.LastActivityTime AS Fin_Reel,\n    o.Status AS Statut_Brut,\n    pos.Max_Active_OP, \n    \n    -- Calcul du retard (toujours simulé à 14h00 pour tes tests) sur l'OP ciblée\n    CASE \n      WHEN o.Status = 'Completed' THEN TIMESTAMPDIFF(SECOND, STR_TO_DATE(CONCAT(p.Annee, '/', TRIM(p.Heure_Fin)), '%Y/%d/%m %H:%i'), o.LastActivityTime)\n      WHEN o.FirstActivityTime IS NOT NULL THEN TIMESTAMPDIFF(SECOND, STR_TO_DATE(CONCAT(p.Annee, '/', TRIM(p.Heure_Fin)), '%Y/%d/%m %H:%i'), IFNULL(o.LastActivityTime, STR_TO_DATE('2026-01-27 14:00:00', '%Y-%m-%d %H:%i:%s')))\n      WHEN STR_TO_DATE('2026-01-27 14:00:00', '%Y-%m-%d %H:%i:%s') > STR_TO_DATE(CONCAT(p.Annee, '/', TRIM(p.Heure_Fin)), '%Y/%d/%m %H:%i') \n        THEN TIMESTAMPDIFF(SECOND, STR_TO_DATE(CONCAT(p.Annee, '/', TRIM(p.Heure_Fin)), '%Y/%d/%m %H:%i'), STR_TO_DATE('2026-01-27 14:00:00', '%Y-%m-%d %H:%i:%s'))\n      ELSE 0 \n    END AS Diff_Sec\n\n  FROM planning_global p\n  \n  -- Jointure sur la station cible ($station)\n  LEFT JOIN orderoperation o \n    ON CAST(p.OrderNum AS CHAR) = CAST(o.OrderNum AS CHAR)\n   AND CAST(p.OrderStepSequenceNum AS CHAR) = CAST(o.OrderStepSequenceNum AS CHAR)\n   \n  -- Radar : On cherche bêtement le pointage le plus élevé sur la ligne pour localiser la pièce\n  LEFT JOIN (\n    SELECT \n      OrderNum,\n      MAX(CAST(OrderStepSequenceNum AS UNSIGNED)) AS Max_Active_OP\n    FROM orderoperation\n    WHERE FirstActivityTime IS NOT NULL OR Status = 'Completed'\n    GROUP BY OrderNum\n  ) pos ON CAST(p.OrderNum AS CHAR) = CAST(pos.OrderNum AS CHAR)\n\n  WHERE p.Ligne = 'MLG' \n    AND p.Semaine IN ($semaine)\n    AND p.OrderStepSequenceNum IN ($station)\n    AND p.OrderNum != 'Libre'\n) base\n\nORDER BY CAST(SUBSTRING_INDEX(Takt, ' ', -1) AS UNSIGNED) ASC;",
