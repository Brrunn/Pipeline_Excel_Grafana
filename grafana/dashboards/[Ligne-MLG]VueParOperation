          "rawSql": "SELECT COUNT(DISTINCT p.OrderNum) AS Pieces_En_Retard\nFROM planning_global p\nLEFT JOIN orderoperation o \n  ON CAST(p.OrderNum AS CHAR) = CAST(o.OrderNum AS CHAR)\n AND CAST(p.OrderStepSequenceNum AS CHAR) = CAST(o.OrderStepSequenceNum AS CHAR)\nWHERE p.Ligne = 'MLG' \n  AND p.Semaine IN ($semaine)\n  AND p.OrderNum != 'Libre'\n  \n  -- LA MAGIE EST ICI : On exclut TOUS les statuts 'Completed' \n  -- car le tableau les considère comme verts par défaut.\n  AND IFNULL(o.Status, '') != 'Completed'\n  \n  AND (\n    -- La pièce est pointée finie (mais n'a pas le statut Completed, ce qui est rare mais possible)\n    (o.LastActivityTime IS NOT NULL AND o.LastActivityTime > STR_TO_DATE(CONCAT(p.Annee, '/', TRIM(p.Heure_Fin)), '%Y/%d/%m %H:%i'))\n    OR \n    -- La pièce a démarré en retard et tourne encore\n    (o.LastActivityTime IS NULL AND o.FirstActivityTime IS NOT NULL AND o.FirstActivityTime > STR_TO_DATE(CONCAT(p.Annee, '/', TRIM(p.Heure_Fin)), '%Y/%d/%m %H:%i'))\n    OR \n    -- La date simulée à 14h00 a dépassé l'heure limite du planning\n    (STR_TO_DATE('2026-01-27 14:00:00', '%Y-%m-%d %H:%i:%s') > STR_TO_DATE(CONCAT(p.Annee, '/', TRIM(p.Heure_Fin)), '%Y/%d/%m %H:%i'))\n  );",
