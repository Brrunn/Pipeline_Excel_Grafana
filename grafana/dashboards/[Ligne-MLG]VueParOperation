      "pluginVersion": "12.3.1",
      "targets": [
        {
          "dataset": "kpi_db",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n  p.Takt,\n  CONCAT('OP ', p.OrderStepSequenceNum) AS Station,\n  \n  -- La couleur est collée à l'OF dans la case\n  CASE\n    WHEN p.OrderNum = 'Libre' THEN '⚪ Libre'\n    WHEN o.Status = 'Completed' THEN CONCAT('🟢 ', p.OrderNum)\n    \n    -- Le calcul du retard (Simulé au 27 Janvier)\n    WHEN (o.LastActivityTime IS NOT NULL AND o.LastActivityTime > STR_TO_DATE(CONCAT(p.Annee, '/', TRIM(p.Heure_Fin)), '%Y/%d/%m %H:%i'))\n      OR (o.LastActivityTime IS NULL AND o.FirstActivityTime IS NOT NULL AND o.FirstActivityTime > STR_TO_DATE(CONCAT(p.Annee, '/', TRIM(p.Heure_Fin)), '%Y/%d/%m %H:%i'))\n      OR (STR_TO_DATE('2026-01-27 14:00:00', '%Y-%m-%d %H:%i:%s') > STR_TO_DATE(CONCAT(p.Annee, '/', TRIM(p.Heure_Fin)), '%Y/%d/%m %H:%i') AND IFNULL(o.Status, '') != 'Completed')\n      THEN CONCAT('🔴 ', p.OrderNum)\n      \n    -- Reste (Pas commencé ou à l'heure)\n    ELSE CONCAT('🔵 ', p.OrderNum)\n  END AS OF_Visuel\n  \nFROM planning_global p\nLEFT JOIN orderoperation o \n  ON CAST(p.OrderNum AS CHAR) = CAST(o.OrderNum AS CHAR)\n AND CAST(p.OrderStepSequenceNum AS CHAR) = CAST(o.OrderStepSequenceNum AS CHAR)\nWHERE p.Ligne = 'MLG' \n  AND p.Semaine IN ($semaine)\nORDER BY \n  CAST(SUBSTRING_INDEX(p.Takt, ' ', -1) AS UNSIGNED) ASC, \n  CAST(p.OrderStepSequenceNum AS UNSIGNED) ASC;",
